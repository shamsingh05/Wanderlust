<%- layout("/layouts/boilerplate") %>
<body>
    <h1>All Listings</h1>
    
    <form method="GET" action="/listings/new">
        <button >Create new listing</button>
    </form>
    

    <ul>
    <% for(listing of allListings){ %>
        <li> <a href="/listings/<%= listing.id %>"> <%= listing.title %> </a> </li>
        <%} %>
    </ul>
</body>
